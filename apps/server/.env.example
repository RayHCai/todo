DATABASE_URL=postgresql://todo:todo@localhost:5432/todo
APP_PASSWORD=correct horse battery staple
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
COOKIE_SECRET=replace-me-with-32-random-bytes-base64-encoded
SESSION_TTL_DAYS=30
PORT=3000
NODE_ENV=development

# Email reminders (optional). Without RESEND_API_KEY and REMINDER_EMAIL_TO nothing is scheduled.
# RESEND_API_KEY=re_...
# REMINDER_EMAIL_TO=you@example.com
# Default sender only delivers to the Resend account's own address; verify a domain to change it.
# REMINDER_EMAIL_FROM=Todo <onboarding@resend.dev>
# Enables POST /api/reminders for manual sends. Generate like COOKIE_SECRET.
# REMINDER_SECRET=replace-me-with-32-random-bytes-base64-encoded
# REMINDER_TIMEZONE=America/Chicago

# Used by the test suite; the database is created and reset automatically.
TEST_DATABASE_URL=postgresql://todo:todo@localhost:5432/todo_test
